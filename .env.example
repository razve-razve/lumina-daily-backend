# Database — use Supabase's direct connection string (not pooler)
DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.gacucpygzpximyxjmied.supabase.co:5432/postgres

# Supabase project URL (already filled in)
SUPABASE_URL=https://gacucpygzpximyxjmied.supabase.co

# Supabase JWT secret — only needed as legacy fallback, can leave blank
SUPABASE_JWT_SECRET=

# Redis — get this from Upstash dashboard after creating a Redis database
REDIS_URL=rediss://:[PASSWORD]@[HOST].upstash.io:6379

# External APIs
GOOGLE_PLACES_API_KEY=your-google-places-api-key
TIMEZONEDB_API_KEY=your-timezonedb-api-key
OPENAI_API_KEY=your-openai-api-key

# Firebase — path to the service account JSON you download from Firebase console
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
EPHE_PATH=/app/ephe
